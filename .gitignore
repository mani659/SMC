# ============================================================
# SMC Project .gitignore
# ============================================================

# --- Excluded project directories (per project policy) ---

# Visual knowledge base: ~11MB of PNG chart reference material
02_KNOWLEDGE_BASE/

# Historical archives: old reports, logs, MQL5 history, superseded docs
ARCHIVE/

# Reference implementation code (MQL5/legacy bots): proprietary origin,
# kept local-only for consultation — never tracked or pushed
03_REFERENCE_CODE/

# Local market data (never commit): canonical M1/parquet/tick datasets
07_DATA/
*.parquet
*.tick
*.ticks

# Research bulk data: large per-trade / extraction CSVs and result dumps
# (methodology & validation .md records remain tracked; big data artifacts do not)
06_RESEARCH/experiments/*.csv
06_RESEARCH/validation/*.csv
06_RESEARCH/**/*.parquet
06_RESEARCH/**/*.feather
06_RESEARCH/**/*.h5
06_RESEARCH/**/*.hdf5

# Research results output tree (project-wide audit 2026-10-06): bulk run
# artifacts — PNG charts, JSON/CSV result dumps, PDF packs (~90MB, 773
# files as of audit date). Local-only by policy; the tracked methodology
# notes under 06_RESEARCH/ record the conclusions. Curated exceptions (if
# the Architect later wants e.g. setups.csv / summary.json tracked) are
# force-added explicitly: `git add -f 06_RESEARCH/results/<path>`.
06_RESEARCH/results/

# Raw market data (canonical dataset and any data dumps) — root-anchored so
# source packages like 04_SRC/smc/data/ are NOT swallowed (found 2026-09-09:
# plain `data/` had silently excluded the whole smc/data package from git)
*.csv.gz
*.zip
*.7z
*.tar
*.tar.gz
/data/
/datasets/
**/m1_clean.csv
**/*.parquet
**/*.feather

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# --- Testing / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-workspace
.sublime-project

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & runtime artifacts ---
*.log
logs/
*.out
*.pid

# --- MT5 / broker artifacts ---
*.mqh.bak
*.ex5
tester_cache/
MQL5/Profiles/
*.hstory
*.hcc

# --- Jupyter ---
.ipynb_checkpoints/

# --- TradingView / chart exports ---
*.twz

# --- Local secrets / credentials (never commit) ---
*.env
credentials*.json
secrets*.json
*.key
*.pem

# --- Codebuff / agent workspace metadata ---
.freebuff/

# --- Phase D operator pack runtime logs (append-only, local-only) ---
logs/
